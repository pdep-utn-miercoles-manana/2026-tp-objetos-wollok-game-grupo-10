import wollok.game.*
import pantallas.*
import Consumibles.*
import BarraAcad.*
import boton.*
import Modos.*

program juego {
  game.width(32)
  game.height(18)
  game.cellSize(40)
  game.title("¡A estudiar!")
  game.boardGround("pizarron.png")

  game.addVisual(barraAcademica)
  game.addVisual(botonF)
  game.addVisual(botonG)
  game.addVisual(espacio1)
  game.addVisual(espacio2)

  // los dos unicos modos de juego
  keyboard.num1().onPressDo({ modoDeJuego.elegirModo(historia) })
  keyboard.num2().onPressDo({ modoDeJuego.elegirModo(aleatorio) })

  keyboard.f().onPressDo({ modoDeJuego.faseActual().elegirIzquierda() })
  keyboard.g().onPressDo({ modoDeJuego.faseActual().elegirDerecha() })
  keyboard.b().onPressDo({ inventario.consumir() })

  const musica = game.sound("musica.mp3")
  musica.shouldLoop(true)
  musica.volume(0.03) 
  game.schedule(500, { musica.play() })

  menu.mostrar()
  game.start()
}
