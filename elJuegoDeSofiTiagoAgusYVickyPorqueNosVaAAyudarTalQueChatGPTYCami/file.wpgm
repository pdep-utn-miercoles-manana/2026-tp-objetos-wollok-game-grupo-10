import wollok.game.*
import pantallas.*
import Consumibles.*
import BarraAcad.*
import boton.*
import Caminos.*
import Opciones.*

program juego {
  game.width(32)
  game.height(18)
  game.cellSize(40)
  game.title("Juego")

  
  keyboard.num1().onPressDo({modoDeJuego.cambiarA(caminoFacil)}) // esto es para elegir al dificultad
  keyboard.num2().onPressDo({modoDeJuego.cambiarA(caminoMedio) }) 
  keyboard.num3().onPressDo({modoDeJuego.cambiarA(caminoDificil)})

  game.addVisual(barraAcademica)
  game.addVisual(botonF)
  game.addVisual(botonG)
  game.addVisual(espacio1)
  game.addVisual(espacio2)
  game.addVisual(nota_rosa)
  game.addVisual(nota_amarilla)


  keyboard.b().onPressDo({inventario.consumir()})

  keyboard.f().onPressDo({modoDeJuego.caminoActual().elegirIzquierda()})
  keyboard.g().onPressDo({modoDeJuego.caminoActual().elegirDerecha()})
  

  cargaDeOpciones.cargar()
  menu.mostrar()

  game.start()
}

